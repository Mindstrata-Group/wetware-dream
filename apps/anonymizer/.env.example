TEMPORAL_ADDRESS=temporal-server:7233
TEMPORAL_NAMESPACE=default
TASK_QUEUE=anonymizer-python
LOG_LEVEL=INFO

# Оффсайт-бэкап БД (activity backup_database, см. backup.py).
# Без этих переменных activity упадёт при запуске воркфлоу бэкапа —
# сам воркер при этом работает нормально.
# BACKUP_DATABASE_URL=postgres://mindstrata:PASSWORD@postgres:5432/mindstrata?sslmode=disable
# BACKUP_S3_ENDPOINT=https://s3.twcstorage.ru
# BACKUP_S3_REGION=ru-1
# BACKUP_S3_BUCKET=bucket-name
# BACKUP_S3_ACCESS_KEY=...
# BACKUP_S3_SECRET_KEY=...
# BACKUP_S3_PREFIX=db-backups
# BACKUP_KEEP=3
