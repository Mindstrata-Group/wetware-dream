{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "packageManager": "npm",
  "reporters": [
    "clear-text",
    "progress"
  ],
  "mutate": [
    "src/app/admin/utils.ts",
    "src/app/api/_utils.ts",
    "src/app/promo-admin/_utils.ts",
    "src/app/tester/_parts/buildChecksFromStatus.ts",
    "src/app/tester/_parts/computeStats.ts",
    "src/app/_home/utils.ts",
    "src/lib/legalDocs.ts",
    "src/lib/breadcrumbs.ts",
    "src/lib/useApi.ts",
    "src/app/chat/_hooks/chatApiActions.ts",
    "!src/**/*.test.{ts,tsx}",
    "!src/**/*.d.ts",
    "!src/**/_types.ts",
    "!src/app/**/types.ts",
    "!src/app/**/_theme.ts"
  ],
  "thresholds": {
    "high": 70,
    "low": 50,
    "break": 50
  },
  "commandRunner": {
    "command": "npx vitest run src/app/admin/utils.test.ts src/app/api/_utils.test.ts src/app/promo-admin/_utils.test.ts src/app/tester/_parts/tester-parts.test.tsx src/app/_home/utils.test.ts src/lib/legalDocs.test.ts src/lib/breadcrumbs.test.ts src/lib/useApi.test.tsx src/app/chat/_hooks/chatApiActions.test.ts"
  },
  "concurrency": 4,
  "timeoutMS": 60000,
  "coverageAnalysis": "off"
}
