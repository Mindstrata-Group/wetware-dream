{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "packageManager": "npm",
  "reporters": [
    "clear-text",
    "progress"
  ],
  "mutate": [
    "src/app/_home/_dots/physics.ts",
    "src/app/_home/_dots/render.ts",
    "src/app/_home/_dots/interaction.ts",
    "src/app/api/access/status/route.ts",
    "src/app/api/access/promocode/apply/route.ts",
    "src/app/api/promo/validate/route.ts",
    "src/app/api/public/demo-modes/route.ts",
    "src/app/api/public/modes/route.ts",
    "src/app/api/public/tariffs/route.ts",
    "src/middleware.ts",
    "!src/**/*.test.{ts,tsx}",
    "!src/**/*.d.ts",
    "!src/**/_types.ts",
    "!src/app/**/types.ts",
    "!src/app/**/_theme.ts"
  ],
  "thresholds": {
    "high": 70,
    "low": 50,
    "break": 50
  },
  "commandRunner": {
    "command": "npx vitest run src/app/_home/_dots/dots-helpers.test.ts src/app/api/route-handlers.test.ts src/middleware.test.ts"
  },
  "concurrency": 4,
  "timeoutMS": 60000,
  "coverageAnalysis": "off"
}
