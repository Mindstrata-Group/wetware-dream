PORT=18080
APP_ENV=local
DATABASE_URL=host=localhost port=5432 user=mindstrata password=mind dbname=mindstrata sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:3000
ENABLE_LIVE_AI=false
# Ключ vsegpt задаётся только в админке (Оркестрация → AI → шлюз vsegpt).
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Data protection (docs/specs/data-protection.md): none|ru|eu|us, and the
# ISO code of the country where the database is hosted.
DATA_PROTECTION_PROFILE=none
DATA_STORAGE_COUNTRY=
# Max Messenger webhook secret: 32+ random chars of [A-Za-z0-9_-]
# (e.g. `openssl rand -hex 24`). Forms /webhooks/max/<secret> and must match the
# X-Max-Bot-Api-Secret header. Empty = the webhook route is not registered.
MAX_WEBHOOK_SECRET=
