# Local run (docker-compose.yml). Copy to .env and change the values.
# .env is never committed. For a server use deploy/.env.prod.example.

# Database password. Generate: openssl rand -hex 16
POSTGRES_PASSWORD=change-me

# One-time key that creates the first administrator (see README).
# Generate: openssl rand -hex 32
BOOTSTRAP_ADMIN_TOKEN=change-me

# Signs the guest cookie. Generate: openssl rand -hex 32
GUEST_COOKIE_SECRET=change-me

# Addresses people use to open the site and the API.
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:18080
WEB_PORT=3000
API_PORT=18080

# AI provider keys are entered in the admin panel, not here.
